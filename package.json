{
  "name": "demoframe",
  "version": "1.0.1",
  "description": "Template-driven demo GIF/MP4 generator: compose scenes in device frames, render deterministically in Chromium, encode for READMEs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "demoframe": "dist/cli.js",
    "demoframe-mcp": "dist/mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bprateeek/demoframe.git"
  },
  "bugs": {
    "url": "https://github.com/bprateeek/demoframe/issues"
  },
  "homepage": "https://github.com/bprateeek/demoframe#readme",
  "files": [
    "dist",
    "schema",
    "docs/llms.txt",
    "docs/categories",
    "skills",
    "examples",
    "templates",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "fieldwork:ab": "npm run build && node scripts/fieldwork-ab-matrix.mjs",
    "fieldwork:cinematic": "npm run build && node scripts/fieldwork-cinematic-sibling.mjs",
    "test": "vitest run",
    "test:shots": "SHOT_LAYOUT=1 SHOT_EXACT=1 vitest run src/qa/compositorLayout.test.ts src/shotsDeterminism.test.ts src/render/shotGraph.test.ts src/qa/shotsStory.test.ts src/qa/primitives.test.ts src/assets/sanitizeSvg.test.ts",
    "test:recipes": "vitest run src/recipes/registry.test.ts src/qa/primitives.test.ts src/render/shotGraph.test.ts",
    "test:qa": "RENDERED_QA=1 vitest run src/qa/rendered.test.ts src/qa/static.test.ts src/qa/diversity.test.ts",
    "schema": "npm run build && node dist/config/export-schema.js",
    "generate:guidance": "node scripts/generate-guidance.mjs",
    "check:guidance": "node scripts/generate-guidance.mjs --check",
    "prepack": "npm run build && node dist/config/export-schema.js && npm run check:guidance"
  },
  "keywords": [
    "gif",
    "demo",
    "readme",
    "screencast",
    "playwright",
    "render"
  ],
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@shikijs/core": "4.2.0",
    "@shikijs/engine-javascript": "4.2.0",
    "@shikijs/langs": "4.2.0",
    "@shikijs/themes": "4.2.0",
    "commander": "^14.0.0",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "^1.53.0",
    "sharp": "^0.34.2",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.24.0"
  }
}
